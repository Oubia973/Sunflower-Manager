# Public URL of the Sunflower Manager API.
REACT_APP_API_URL=https://example.com

# Public Web Push/VAPID key. This is intentionally safe to expose to clients.
REACT_APP_WEBPUSH_PUBLICKEY=replace-with-the-public-vapid-key

# Opt-in preview of the new Inv page. Requires the Modern interface switch too.
REACT_APP_INV_MODERN=0
